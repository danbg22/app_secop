rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD (OWASP + LEY 1581 DE 2012 COLOMBIA)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function rolesInicialesValidos(data) {
      return data.get('rolesActivos', []) is list &&
          data.get('rolesActivos', []).hasOnly(['contratista', 'juridico_supervision']);
    }

    function fechaVigente(fecha) {
      return fecha is timestamp && fecha > request.time;
    }

    function vigenciaDe(datos, rol) {
      return datos.get('historicos', []).hasAny([rol]) ||
          fechaVigente(datos.get('pagadosHasta', {}).get(rol, null)) ||
          (datos.get('pruebaRol', '') == rol &&
           fechaVigente(datos.get('pruebaHasta', null)));
    }

    function planVigente(uid, rol) {
      let ruta = /databases/$(database)/documents/accesos_planes/$(uid);
      return exists(ruta) && (vigenciaDe(get(ruta).data, rol) ||
          (uid != request.auth.uid && get(ruta).data.get('admin', false) == true));
    }

    function rolesGratuitosHabilitados(uid) {
      let ruta = /databases/$(database)/documents/accesos_planes/$(uid);
      return exists(ruta) &&
          (get(ruta).data.rolInicial in ['contratista', 'juridico_supervision'] ||
           vigenciaDe(get(ruta).data, 'persona') ||
           vigenciaDe(get(ruta).data, 'equipo_juridico') ||
           vigenciaDe(get(ruta).data, 'supervisor_contratos'));
    }

    // El Contratista de Supervisión de contratos es gratuito: se puede sumar
    // sin pago (lib/services/auth_service.dart, activarRolGratuito).
    function soloSumaRolGratuito(antes, despues) {
      return despues.rolesActivos is list &&
          despues.rolesActivos.toSet()
              .difference(antes.get('rolesActivos', []).toSet())
              .hasOnly(['contratista','juridico_supervision']);
    }

    // Correos administradores (misma lista que lib/services/admin_access.dart).
    function isAdmin() {
      return isSignedIn() &&
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '').lower() in [
            'danielbg2231@gmail.com',
            'ivanbolano19@gmail.com',
            'ibolano@sena.edu.co'
          ];
    }

    // Titular de la suscripción Equipo Jurídico (o administrador).
    function isMasterJuridico() {
      return isSignedIn() &&
          (isAdmin() || planVigente(request.auth.uid, 'equipo_juridico'));
    }

    // Abogado temporal vigente del equipo de `masterUid`: correo verificado,
    // membresía activa y sin vencer (ver lib/services/equipo_juridico_service.dart).
    function membresiaPropia() {
      return get(/databases/$(database)/documents/miembros_equipo/$(request.auth.token.email)).data;
    }

    function miembroVigente(masterUid) {
      return isSignedIn() &&
          request.auth.token.email_verified == true &&
          exists(/databases/$(database)/documents/miembros_equipo/$(request.auth.token.email)) &&
          membresiaPropia().masterUid == masterUid &&
          membresiaPropia().estado == 'activo' &&
          membresiaPropia().vigenteHasta > request.time &&
          planVigente(masterUid, 'equipo_juridico');
    }

    function permisoEquipo(masterUid, permiso) {
      return miembroVigente(masterUid) && membresiaPropia().permisos.hasAny([permiso]);
    }

    // Archivo en un solo documento (`archivoBase64`) o dividido en `partes`
    // (ver lib/services/archivo_fragmentado.dart); máximo 25 MB = 40 partes.
    function archivoValido(data) {
      return isNonEmptyString(data.get('archivoBase64', ''), 950000) ||
          (data.get('partes', 0) is int &&
           data.get('partes', 0) > 0 &&
           data.get('partes', 0) <= 50);
    }

    // Elimina un expediente quien lo creó, el Master de su equipo o un
    // abogado del equipo con permiso para crear contratos.
    function puedeEliminarExpediente(data) {
      return isSignedIn() &&
          ((isMasterJuridico() && (data.get('creadoPorUid', '') == request.auth.uid ||
                                   data.get('equipoUid', '') == request.auth.uid)) ||
           (data.get('equipoUid', '') != '' &&
            permisoEquipo(data.equipoUid, 'crear_contratos')));
    }

    function expedienteDe(token) {
      return get(/databases/$(database)/documents/expedientes_juridicos/$(token)).data;
    }

    function expedienteActivo(token) {
      return !exists(/databases/$(database)/documents/expedientes_juridicos/$(token)) ||
          expedienteDe(token).get('eliminado', false) != true;
    }

    // Equipo dueño de un expediente (el creador en expedientes antiguos).
    function equipoDeExpediente(token) {
      let d = expedienteDe(token);
      return d.get('equipoUid', '') != '' ? d.equipoUid : d.get('creadoPorUid', '');
    }

    function esEquipoDeExpediente(token) {
      let equipo = equipoDeExpediente(token);
      return isSignedIn() &&
          ((isMasterJuridico() && (equipo == request.auth.uid ||
             expedienteDe(token).get('creadoPorUid', '') == request.auth.uid)) ||
           miembroVigente(equipo));
    }

    // Sesión con correo verificado: la supervisión se asigna por correo, y
    // sin verificarlo cualquiera podría registrarse con el correo de otro.
    function correoVerificado() {
      return isSignedIn() &&
          request.auth.token.get('email', '') != '' &&
          request.auth.token.get('email_verified', false) == true;
    }

    // Designación de la supervisión del contrato (la hace el equipo jurídico
    // que lo creó; ver lib/services/supervision_service.dart).
    function rutaAsignacion(token) {
      return /databases/$(database)/documents/asignaciones_supervision/$(token);
    }

    // Supervisor designado del contrato: configura los informes, decide
    // cualquier etapa y registra el pago. El equipo jurídico ya no supervisa.
    function esSupervisorDeExpediente(token) {
      return correoVerificado() && tieneRol('supervisor_contratos') &&
          exists(rutaAsignacion(token)) &&
          get(rutaAsignacion(token)).data.get('supervisorEmail', '') == request.auth.token.email.lower();
    }

    function revisorSupervision() {
      return correoVerificado() && (tieneRol('supervisor_contratos') || tieneRol('juridico_supervision'));
    }

    // Supervisor o responsable de alguna etapa de la cadena de aprobación.
    function esRevisorDeExpediente(token) {
      return revisorSupervision() &&
          exists(rutaAsignacion(token)) &&
          get(rutaAsignacion(token)).data.get('revisoresEmails', []).hasAny([request.auth.token.email.lower()]);
    }

    // Responsable de la etapa `i` de la cadena de aprobación del contrato.
    function esResponsableEtapa(token, i) {
      let ruta = /databases/$(database)/documents/expedientes_juridicos/$(token)/supervision/plan;
      return revisorSupervision() &&
          exists(ruta) &&
          get(ruta).data.get('etapas', []).size() > i &&
          get(ruta).data.etapas[i].get('responsableEmail', '') == request.auth.token.email.lower();
    }

    function ultimaEtapaExpediente(token, i) {
      let etapas = get(/databases/$(database)/documents/expedientes_juridicos/$(token)/supervision/plan).data.etapas;
      return etapas.size() > 0 && i >= etapas.size() - 1;
    }

    // Lo que puede cambiar en el expediente quien solo tiene el enlace del
    // contratista (lib/services/juridico_contratacion_service.dart,
    // _escribirCambiosDelContratista): sus documentos, su ingreso y eventos
    // nuevos en la trazabilidad. Las decisiones del equipo (aprobar,
    // devolver, aval, `decisiones`) y los datos del contrato quedan fuera.
    function cambioDelContratista(antes, despues) {
      let cambios = despues.diff(antes).affectedKeys();
      return cambios.hasOnly(['apartados', 'trazabilidad', 'actualizadoEnMs',
                              'ultimoContratistaValidadoNombre',
                              'ultimoContratistaValidadoCedula',
                              'contratistaNombreEsperado',
                              'contratistaCedulaEsperada']) &&
          // El nombre y la cédula esperados solo se completan si estaban vacíos.
          (!cambios.hasAny(['contratistaNombreEsperado']) ||
           antes.get('contratistaNombreEsperado', '') == '') &&
          (!cambios.hasAny(['contratistaCedulaEsperada']) ||
           antes.get('contratistaCedulaEsperada', '') == '') &&
          // La trazabilidad solo crece y ningún documento desaparece.
          despues.get('trazabilidad', []).hasAll(antes.get('trazabilidad', [])) &&
          despues.get('apartados', []).size() >= antes.get('apartados', []).size();
    }

    // El informe del periodo todavía no existe o está en borrador o devuelto.
    function informeEditable(token, periodo) {
      let ruta = /databases/$(database)/documents/expedientes_juridicos/$(token)/informes/$(periodo);
      return !exists(ruta) || get(ruta).data.get('estado', 'borrador') in ['borrador', 'devuelto'];
    }

    // Campos que escribe el contratista desde su enlace y los del equipo.
    function camposContratistaInforme() {
      return ['id', 'numero', 'desdeIso', 'hastaIso', 'estado', 'valorCobradoCop',
              'actividades', 'anexos', 'planillas', 'pensionado', 'motivoNoPension',
              'estampilla', 'datosCobro', 'documentos', 'declaracion', 'enviadoEnIso',
              'primeraPresentacionIso', 'respuestas', 'historial', 'actualizadoEnMs'];
    }

    function camposEquipoInforme() {
      return ['estado', 'etapaActual', 'revisiones', 'declaracion', 'aprobadoEnIso',
              'pagoReferencia', 'pagadoEnIso', 'historial', 'actualizadoEnMs'];
    }

    // Master del equipo o abogado vigente de su equipo.
    function esDelEquipo(equipoUid) {
      return isSignedIn() &&
          ((equipoUid == request.auth.uid && isMasterJuridico()) || miembroVigente(equipoUid));
    }

    // Credenciales de vigencia, reclamos de prueba e intentos: solo Admin SDK.
    match /accesos_planes/{uid} {
      allow read, write: if false;
    }

    match /identidades_prueba/{huella} {
      allow read, write: if false;
    }

    match /intentos_pago_planes/{referencia} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. PERFILES DE USUARIO (`usuarios/{uid}`) - PROTECCIÓN ESTRICTA DE PII
    // =========================================================================
    match /usuarios/{uid} {
      // Prohibido listar (`list`) usuarios para impedir raspado masivo de PII
      // (cédulas, teléfonos, correos). Solo el titular autenticado lee su perfil.
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid) &&
          request.resource.data.uid == uid &&
          rolesInicialesValidos(request.resource.data) &&
          request.resource.data.get('documento', '') == '' &&
          request.resource.data.get('documentoNormalizado', '') == '' &&
          !('cedulaVinculada' in request.resource.data) &&
          request.resource.data.get('pagoWompiActivo', false) == false &&
          request.resource.data.get('ultimoPagoWompi', null) == null;

      allow update: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
          // Inmutabilidad de correo, cédula y consentimiento una vez establecidos
          (!('email' in resource.data) ||
           resource.data.email == '' ||
           request.resource.data.email == resource.data.email) &&
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['documento', 'documentoNormalizado', 'cedulaVinculada']) &&
          (!('aceptacion_datos' in resource.data) ||
           resource.data.aceptacion_datos != true ||
           request.resource.data.aceptacion_datos == true) &&
          (!('rolInicialRegistro' in resource.data) ||
           request.resource.data.rolInicialRegistro == resource.data.rolInicialRegistro) &&
          request.resource.data.get('pagoWompiActivo', false) == resource.data.get('pagoWompiActivo', false) &&
          request.resource.data.get('ultimoPagoWompi', null) == resource.data.get('ultimoPagoWompi', null) &&
          (request.resource.data.get('rolesActivos', []) == resource.data.get('rolesActivos', []) ||
           soloSumaRolGratuito(resource.data, request.resource.data));

      allow delete: if false;

      // Evidencia probatoria inmutable ante la SIC (Ley 1581/2012 - Art. 8 y 12)
      match /auditoria_consentimiento/{logId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) &&
            request.resource.data.uid == uid &&
            request.resource.data.aceptacion_datos == true &&
            request.resource.data.aceptacion_politica_privacidad == true;
        allow update, delete: if false;
      }

      // Radicados históricos del titular guardados en su perfil.
      match /pqrs_solicitudes/{radicado} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && nuevaPqrs(radicado);
        allow update: if respuestaAdminPqrs() || lecturaPqrs(uid);
        allow delete: if false;
      }
    }

    // =========================================================================
    // 2. ÍNDICES OPACOS DE UNICIDAD (`indices_unicidad/{sha256Hash}`)
    // =========================================================================
    match /indices_unicidad/{hash} {
      // Solo el dueño lee su índice: nadie puede averiguar si una cédula o
      // un correo ajenos tienen cuenta. La unicidad la garantiza `create`.
      allow get: if isSignedIn() && hash.matches('^[a-f0-9]{64}$') &&
          resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() &&
          hash.matches('^[a-f0-9]{64}$') &&
          !exists(/databases/$(database)/documents/indices_unicidad/$(hash)) &&
          request.resource.data.keys().hasOnly(['tipo', 'uid', 'creado_en']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.tipo == 'email';
      allow update, delete: if false;
    }

    // =========================================================================
    // 3. LIBRO MAYOR INMUTABLE DE PAGOS WOMPI (`pagos_wompi/{transactionId}`)
    // =========================================================================
    match /pagos_wompi/{transactionId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =========================================================================
    // 4. EXPEDIENTES CONTRACTUALES EQUIPO JURÍDICO + PORTAL INVITADO (`expedientes_juridicos/{token}`)
    // =========================================================================
    // El `token` es un identificador criptográfico CSPRNG de 32-64 caracteres hexadecimales:
    // - Prohibido listar globalmente sin ser el propietario creador.
    // - Cualquier actor que posea el enlace con el token criptográfico exacto puede
    //   suscribirse en tiempo real (`get`) y sincronizar cargas, revisiones y trazabilidad.
    match /expedientes_juridicos/{token} {
      allow get: if token.matches('^[a-f0-9]{32,64}$');
      // Listan el creador, el Master del equipo y sus abogados vigentes.
      allow list: if isSignedIn() &&
          ((isMasterJuridico() && (resource.data.creadoPorUid == request.auth.uid ||
                                   resource.data.equipoUid == request.auth.uid)) ||
           miembroVigente(resource.data.equipoUid));
      // Lo crea el equipo, siempre con sesión (antes cualquiera podía crear
      // expedientes sin iniciar sesión).
      allow create: if isSignedIn() &&
          token.matches('^[a-f0-9]{32,64}$') &&
          request.resource.data.tokenInvitado == token &&
          isNonEmptyString(request.resource.data.numeroContrato, 80) &&
          isNonEmptyString(request.resource.data.objetoContrato, 2000) &&
          // Un expediente de equipo solo lo crea su Master o un abogado con permiso.
          ((isMasterJuridico() &&
            request.resource.data.get('equipoUid', '') in ['', request.auth.uid]) ||
           (request.resource.data.get('equipoUid', '') != '' &&
            permisoEquipo(request.resource.data.equipoUid, 'crear_contratos')));
      // Un expediente eliminado queda solo como marca, sin datos personales,
      // y ya no admite cambios.
      allow update: if token.matches('^[a-f0-9]{32,64}$') &&
          resource.data.get('eliminado', false) != true &&
          (request.resource.data.get('eliminado', false) != true ||
           puedeEliminarExpediente(resource.data)) &&
          request.resource.data.tokenInvitado == resource.data.tokenInvitado &&
          request.resource.data.numeroContrato == resource.data.numeroContrato &&
          // El propietario no puede ser reasignado por quien tenga el enlace.
          (!('creadoPorUid' in resource.data) ||
           request.resource.data.creadoPorUid == resource.data.creadoPorUid) &&
          // El equipo tampoco; solo el creador asigna el suyo a expedientes antiguos.
          (resource.data.get('equipoUid', '') == '' ?
              (request.resource.data.get('equipoUid', '') == '' ||
               (isSignedIn() &&
                request.resource.data.equipoUid == request.auth.uid &&
                resource.data.creadoPorUid == request.auth.uid)) :
              request.resource.data.get('equipoUid', '') == resource.data.equipoUid) &&
          // El equipo cambia todo; quien solo tiene el enlace, lo suyo.
          (esEquipoDeExpediente(token) ||
           cambioDelContratista(resource.data, request.resource.data));
      allow delete: if puedeEliminarExpediente(resource.data);

      // Supervisión mensual: plan del contrato (lo configura el supervisor
      // designado) e informes del contratista, que aprueba la cadena de
      // revisores del supervisor.
      match /supervision/{doc} {
        allow get: if token.matches('^[a-f0-9]{32,64}$');
        // Firma registrada del contratista (la escribe desde su enlace).
        allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
            doc == 'firma' &&
            expedienteActivo(token) &&
            request.resource.data.keys().hasOnly(['archivoBase64', 'partes', 'mime', 'actualizadoEnIso']) &&
            isNonEmptyString(request.resource.data.archivoBase64, 900000);
        // El plan lo configura el supervisor designado (no el equipo jurídico).
        allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
            doc == 'plan' &&
            expedienteActivo(token) &&
            esSupervisorDeExpediente(token) &&
            request.resource.data.etapas is list &&
            request.resource.data.etapas.size() > 0 &&
            request.resource.data.etapas.size() <= 5 &&
            request.resource.data.obligaciones is list &&
            request.resource.data.obligaciones.size() <= 60;
        allow delete: if puedeEliminarExpediente(expedienteDe(token));
      }

      match /informes/{periodo} {
        allow get, list: if token.matches('^[a-f0-9]{32,64}$');
        // El contratista crea su informe (id = fecha de inicio del periodo).
        allow create: if token.matches('^[a-f0-9]{32,64}$') &&
            periodo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            expedienteActivo(token) &&
            request.resource.data.id == periodo &&
            request.resource.data.estado in ['borrador', 'enRevision'] &&
            request.resource.data.keys().hasOnly(camposContratistaInforme());
        allow update: if token.matches('^[a-f0-9]{32,64}$') &&
            expedienteActivo(token) &&
            request.resource.data.id == periodo &&
            (
              // Contratista: solo sus campos y mientras el informe es editable.
              (resource.data.estado in ['borrador', 'devuelto'] &&
               request.resource.data.estado in ['borrador', 'devuelto', 'enRevision'] &&
               (request.resource.data.estado != 'devuelto' ||
                resource.data.estado == 'devuelto') &&
               request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(camposContratistaInforme()) &&
               // La trazabilidad solo crece.
               request.resource.data.get('historial', []).hasAll(resource.data.get('historial', []))) ||
              // Etapa en curso: la decide su responsable o el supervisor designado.
              (resource.data.estado == 'enRevision' &&
               request.resource.data.estado in ['enRevision', 'devuelto', 'aprobado'] &&
               request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(camposEquipoInforme()) &&
               ((esSupervisorDeExpediente(token) &&
                 (request.resource.data.estado != 'aprobado' ||
                  ultimaEtapaExpediente(token, resource.data.get('etapaActual', 0)))) ||
                (request.resource.data.estado != 'aprobado' &&
                 esResponsableEtapa(token, resource.data.get('etapaActual', 0))))) ||
              // Registro del pago de un informe aprobado.
              (resource.data.estado == 'aprobado' &&
               request.resource.data.estado == 'pagado' &&
               esSupervisorDeExpediente(token) &&
               request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(camposEquipoInforme()))
            );
        allow delete: if puedeEliminarExpediente(expedienteDe(token));

        match /archivos/{tipo} {
          allow get, list: if token.matches('^[a-f0-9]{32,64}$');
          // Los soportes de un informe se cambian mientras el contratista lo
          // edita; enviado, aprobado o pagado, solo sus revisores.
          allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
              expedienteActivo(token) &&
              archivoValido(request.resource.data) &&
              (informeEditable(token, periodo) || esRevisorDeExpediente(token));
          allow delete: if puedeEliminarExpediente(expedienteDe(token));

          match /partes/{parte} {
            allow get, list: if token.matches('^[a-f0-9]{32,64}$');
            allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
                expedienteActivo(token) &&
                isNonEmptyString(request.resource.data.datos, 950000) &&
                (informeEditable(token, periodo) || esRevisorDeExpediente(token));
            allow delete: if puedeEliminarExpediente(expedienteDe(token));
          }
        }
      }

      // Subcolección de binarios individuales para sincronización entre dispositivos.
      // Los archivos de más de ~500 KB se dividen en `partes` (hasta 25 MB).
      match /archivos/{apartadoId} {
        allow get, list: if token.matches('^[a-f0-9]{32,64}$');
        allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
            archivoValido(request.resource.data) &&
            expedienteActivo(token);
        allow delete: if puedeEliminarExpediente(expedienteDe(token));

        match /partes/{parte} {
          allow get, list: if token.matches('^[a-f0-9]{32,64}$');
          allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
              isNonEmptyString(request.resource.data.datos, 950000) &&
              expedienteActivo(token);
          allow delete: if puedeEliminarExpediente(expedienteDe(token));
        }
      }
    }

    // =========================================================================
    // Designaciones anteriores. Se conservan para los contratos ya existentes.
    match /asignaciones_supervision/{token} {
      allow read: if revisorSupervision() &&
          request.auth.token.email.lower() in resource.data.revisoresEmails;
      allow update: if esSupervisorDeExpediente(token) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revisoresEmails','actualizadoEnMs']) &&
          request.resource.data.revisoresEmails is list &&
          request.resource.data.revisoresEmails.size() <= 8 &&
          resource.data.supervisorEmail in request.resource.data.revisoresEmails;
      allow delete: if puedeEliminarExpediente(expedienteDe(token));
    }

    function tieneRol(rol) {
      return isSignedIn() && (isAdmin() ||
          (rol in ['contratista', 'juridico_supervision'] ?
            (rolesGratuitosHabilitados(request.auth.uid) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rolesActivos', []).hasAny([rol])) :
            planVigente(request.auth.uid, rol)));
    }

    function titularSupervision(uid) {
      return isOwner(uid) && correoVerificado() && tieneRol('supervisor_contratos');
    }

    function perfilSupervisor(uid) {
      return /databases/$(database)/documents/perfiles_supervision/$(uid);
    }

    function rutaCodigoSupervision(codigo) {
      return /databases/$(database)/documents/codigos_supervision/$(codigo);
    }

    function codigoSupervisionValido(codigo) {
      return codigo is string && codigo.matches('^SUP-[A-F0-9]{24}$');
    }

    function codigoDelPerfil(uid) {
      let datos = request.resource.data;
      let codigo = datos.get('codigoSupervisor', '');
      return codigoSupervisionValido(codigo) &&
          (!exists(perfilSupervisor(uid)) ||
            get(perfilSupervisor(uid)).data.get('codigoSupervisor', codigo) == codigo) &&
          getAfter(rutaCodigoSupervision(codigo)).data.supervisorUid == uid &&
          getAfter(rutaCodigoSupervision(codigo)).data.entidadNit == datos.entidadNit;
    }

    // La vinculación y el documento de nombramiento solo los consulta el titular.
    match /perfiles_supervision/{uid} {
      allow get: if titularSupervision(uid);
      allow create, update: if titularSupervision(uid) &&
          codigoDelPerfil(uid) &&
          request.resource.data.vinculacion in ['nombramiento', 'contrato'] &&
          request.resource.data.entidadNit.matches('^[0-9]{9}$') &&
          isNonEmptyString(request.resource.data.entidadNombre, 160) &&
          isNonEmptyString(request.resource.data.dependencia, 160) &&
          isNonEmptyString(request.resource.data.supervisorNombre, 160) &&
          isNonEmptyString(request.resource.data.referencia, 160) &&
          isNonEmptyString(request.resource.data.cargoObjeto, 2000) &&
          (request.resource.data.vinculacion == 'nombramiento' ||
            (request.resource.data.valorContratoCop is int && request.resource.data.valorContratoCop > 0 &&
             isNonEmptyString(request.resource.data.plazoEjecucion,160) && isNonEmptyString(request.resource.data.formaPago,160) &&
             isNonEmptyString(request.resource.data.rp,160) && isNonEmptyString(request.resource.data.cdp,160))) &&
          request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          getAfter(/databases/$(database)/documents/juridicos_supervision/$(uid)).data.email == request.resource.data.juridicoEmail &&
          getAfter(/databases/$(database)/documents/juridicos_supervision/$(uid)).data.nombre == request.resource.data.juridicoNombre;
    }

    match /codigos_supervision/{codigo} {
      function coincideConTitular() {
        let datos = request.resource.data;
        let perfil = getAfter(perfilSupervisor(request.auth.uid)).data;
        return codigoSupervisionValido(codigo) &&
            datos.keys().hasOnly(['supervisorUid', 'entidadNit']) &&
            datos.supervisorUid == request.auth.uid &&
            perfil.codigoSupervisor == codigo && perfil.entidadNit == datos.entidadNit;
      }
      allow get: if tieneRol('contratista');
      allow create: if titularSupervision(request.auth.uid) && coincideConTitular();
      allow update: if titularSupervision(resource.data.supervisorUid) && coincideConTitular();
    }

    function coincideConPerfil(d, uid) {
      let p = getAfter(perfilSupervisor(uid)).data;
      return d.entidadNit == p.entidadNit && d.entidadNombre == p.entidadNombre &&
          d.supervisorNombre == p.supervisorNombre && d.dependencia == p.dependencia;
    }

    match /directorio_supervision/{nit}/supervisores/{uid} {
      allow delete: if titularSupervision(uid) && getAfter(perfilSupervisor(uid)).data.entidadNit != nit;
      allow read: if tieneRol('contratista') || titularSupervision(uid);
      allow create, update: if titularSupervision(uid) && request.resource.data.entidadNit == nit &&
          request.resource.data.keys().hasOnly(['entidadNit','entidadNombre','dependencia','supervisorNombre']) &&
          coincideConPerfil(request.resource.data, uid);
    }

    match /juridicos_supervision/{uid} {
      allow read: if titularSupervision(uid) || (correoVerificado() && tieneRol('juridico_supervision') &&
          resource.data.email == request.auth.token.email.lower());
      allow create, update: if titularSupervision(uid) && coincideConPerfil(request.resource.data, uid) &&
          isNonEmptyString(request.resource.data.nombre, 160) &&
          isNonEmptyString(request.resource.data.email, 160) &&
          request.resource.data.email == request.resource.data.email.lower() &&
          request.resource.data.email != request.auth.token.email.lower();
    }

    match /contratos_supervision/{id} {
      function contrato() {
        return get(/databases/$(database)/documents/contratos_supervision/$(id)).data;
      }
      function contratista(d) {
        return isOwner(d.contratistaUid) && tieneRol('contratista');
      }
      function juridico(d) {
        return correoVerificado() && tieneRol('juridico_supervision') &&
            request.auth.token.email.lower() in d.revisoresEmails;
      }
      function participa(d) {
        return contratista(d) || titularSupervision(d.supervisorUid) || juridico(d);
      }
      function destinoValido(d) {
        let ref = /databases/$(database)/documents/directorio_supervision/$(d.entidadNit)/supervisores/$(d.supervisorUid);
        let entrada = get(ref).data;
        let codigo = get(rutaCodigoSupervision(d.codigoSupervisor)).data;
        return codigoSupervisionValido(d.codigoSupervisor) &&
            codigo.supervisorUid == d.supervisorUid && codigo.entidadNit == d.entidadNit &&
            entrada.entidadNombre == d.entidadNombre && entrada.dependencia == d.dependencia &&
            entrada.supervisorNombre == d.supervisorNombre;
      }
      function vinculacionAprobada(d) {
        return d.get('estadoVinculacion', 'aprobada') == 'aprobada';
      }
      function resolverVinculacion() {
        let antes = resource.data;
        let d = request.resource.data;
        let designacion = get(/databases/$(database)/documents/juridicos_supervision/$(antes.supervisorUid)).data;
        let cambios = d.diff(antes).affectedKeys();
        return antes.get('estadoVinculacion', '') == 'pendiente' &&
            ((d.estadoVinculacion == 'aprobada' &&
                cambios.hasOnly(['estadoVinculacion','observacionVinculacion','juridicoRevisionEmail',
                  'juridicoRevisionNombre','revisoresEmails']) &&
                d.get('observacionVinculacion', '') == '' &&
                d.juridicoRevisionEmail == designacion.email && d.juridicoRevisionNombre == designacion.nombre &&
                d.juridicoRevisionEmail != antes.contratistaCorreo &&
                d.revisoresEmails == [d.juridicoRevisionEmail]) ||
             (d.estadoVinculacion == 'devuelta' &&
                cambios.hasOnly(['estadoVinculacion','observacionVinculacion']) &&
                isNonEmptyString(d.observacionVinculacion, 1000) && d.observacionVinculacion.size() >= 10));
      }
      function camposEconomicosContrato() {
        return ['objetoContrato','aprobacionSecop','valorContratoCop','plazoEjecucion','formaPago','rp','cdp'];
      }
      function datoContratoValido(d) {
        return isNonEmptyString(d.numeroContrato, 80) && isNonEmptyString(d.objetoContrato, 2000) &&
            d.valorContratoCop is int && d.valorContratoCop > 0 &&
            isNonEmptyString(d.plazoEjecucion,160) && isNonEmptyString(d.formaPago,160) &&
            isNonEmptyString(d.rp,160) && isNonEmptyString(d.cdp,160) &&
            d.aprobacionSecop.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      allow get: if tieneRol('contratista') && id.matches('^sc_[a-f0-9]{64}$') &&
          !exists(/databases/$(database)/documents/contratos_supervision/$(id));
      allow read: if participa(resource.data);
      allow create: if contratista(request.resource.data) &&
          id.matches('^sc_[a-f0-9]{64}$') && request.resource.data.id == id &&
          request.resource.data.estadoVinculacion == 'pendiente' &&
          request.resource.data.tokenInvitado == id && request.resource.data.revisoresEmails == [] &&
          request.resource.data.contratistaCorreo == request.auth.token.email.lower() &&
          request.resource.data.supervisorUid != request.auth.uid &&
          request.resource.data.keys().hasOnly(['id','tokenInvitado','supervisorUid','contratistaUid',
            'codigoSupervisor','estadoVinculacion',
            'entidadNit','entidadNombre','dependencia','supervisorNombre','revisoresEmails',
            'contratistaNombreEsperado','contratistaCedulaEsperada','contratistaCorreo','numeroContrato',
            'objetoContrato','valorContratoCop','plazoEjecucion','formaPago','rp','cdp','aprobacionSecop']) &&
          destinoValido(request.resource.data) && datoContratoValido(request.resource.data);
      allow update: if titularSupervision(resource.data.supervisorUid) &&
          resolverVinculacion();
      allow update: if contratista(resource.data) &&
          resource.data.get('estadoVinculacion', '') == 'devuelta' &&
          request.resource.data.estadoVinculacion == 'pendiente' &&
          request.resource.data.observacionVinculacion == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            camposEconomicosContrato().concat(['estadoVinculacion','observacionVinculacion'])) &&
          datoContratoValido(request.resource.data);
      allow update: if titularSupervision(resource.data.supervisorUid) &&
          vinculacionAprobada(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revisoresEmails','supervisorEmail']) &&
          request.resource.data.supervisorEmail == request.auth.token.email.lower() &&
          request.resource.data.revisoresEmails is list && request.resource.data.revisoresEmails.size() <= 5 &&
          (resource.data.get('juridicoRevisionEmail', '') == '' ||
            resource.data.juridicoRevisionEmail in request.resource.data.revisoresEmails) &&
          !(resource.data.contratistaCorreo in request.resource.data.revisoresEmails);

      allow update: if titularSupervision(resource.data.supervisorUid) &&
          vinculacionAprobada(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposEconomicosContrato()) &&
          datoContratoValido(request.resource.data);

      match /supervision/{doc} {
        function flujoDelContrato(d, etapas) {
          return d.get('juridicoRevisionEmail', '') == '' ||
              (etapas.size() >= 2 &&
                etapas[0].id == 'juridico' && etapas[0].responsableEmail == d.juridicoRevisionEmail &&
                etapas[etapas.size() - 1].id == 'supervisor' &&
                etapas[etapas.size() - 1].responsableEmail == request.auth.token.email.lower());
        }
        allow get: if participa(contrato());
        allow create, update: if doc == 'plan' && titularSupervision(contrato().supervisorUid) &&
            vinculacionAprobada(contrato()) &&
            request.resource.data.etapas is list && request.resource.data.etapas.size() in [1,2,3,4,5] &&
            flujoDelContrato(contrato(), request.resource.data.etapas) &&
            request.resource.data.obligaciones is list && request.resource.data.obligaciones.size() > 0 &&
            request.resource.data.obligaciones.size() <= 60;
        allow create, update: if doc == 'firma' && contratista(contrato()) &&
            vinculacionAprobada(contrato()) &&
            request.resource.data.keys().hasOnly(['archivoBase64','partes','mime','actualizadoEnIso']) &&
            isNonEmptyString(request.resource.data.archivoBase64, 900000);
      }

      match /informes/{periodo} {
        function decisionValida(d) {
          let etapas = get(/databases/$(database)/documents/contratos_supervision/$(id)/supervision/plan).data.etapas;
          let i = resource.data.get('etapaActual', 0);
          let actual = i < etapas.size() ? i : etapas.size() - 1;
          let estado = request.resource.data.estado;
          let nuevo = request.resource.data.get('etapaActual', 0);
          let supervisor = titularSupervision(d.supervisorUid);
          let responsable = juridico(d) && etapas[actual].responsableEmail == request.auth.token.email.lower();
          let flujoJuridico = d.get('juridicoRevisionEmail', '') != '';
          return resource.data.estado == 'enRevision' &&
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pagoReferencia','pagadoEnIso']) &&
              (estado == 'aprobado' ||
                request.resource.data.get('aprobadoEnIso', '') == resource.data.get('aprobadoEnIso', '')) &&
              ((estado == 'devuelto' && (supervisor || responsable) && nuevo == (flujoJuridico ? 0 : i)) ||
               (estado == 'enRevision' && (responsable || (supervisor &&
                (!flujoJuridico || etapas[actual].responsableEmail == request.auth.token.email.lower()))) &&
                actual + 1 < etapas.size() && nuevo == actual + 1) ||
               (estado == 'aprobado' && supervisor && actual + 1 == etapas.size() && nuevo == i));
        }
        allow read: if participa(contrato());
        allow create: if contratista(contrato()) && periodo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
            vinculacionAprobada(contrato()) &&
            exists(/databases/$(database)/documents/contratos_supervision/$(id)/supervision/plan) &&
            request.resource.data.id == periodo && request.resource.data.estado in ['borrador','enRevision'] &&
            request.resource.data.keys().hasOnly(camposContratistaInforme());
        allow update: if request.resource.data.id == periodo &&
            vinculacionAprobada(contrato()) &&
            ((contratista(contrato()) && resource.data.estado in ['borrador','devuelto'] &&
              (request.resource.data.estado == resource.data.estado || request.resource.data.estado == 'enRevision') &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposContratistaInforme())) ||
             (request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposEquipoInforme()) &&
              (decisionValida(contrato()) || (titularSupervision(contrato().supervisorUid) &&
               resource.data.estado == 'aprobado' && request.resource.data.estado == 'pagado'))));

        function editable() {
          let informe = get(/databases/$(database)/documents/contratos_supervision/$(id)/informes/$(periodo)).data;
          return contratista(contrato()) && informe.estado in ['borrador','devuelto'];
        }
        match /archivos/{archivo} {
          allow read: if participa(contrato());
          allow create, update: if editable() && archivoValido(request.resource.data);
          match /partes/{parte} {
            allow read: if participa(contrato());
            allow create, update: if editable() && isNonEmptyString(request.resource.data.datos, 950000);
          }
        }
      }
    }

    // 4b. EQUIPO JURÍDICO "MASTER CHIEF" (`miembros_equipo/{correo}`)
    // =========================================================================
    // El Master Jurídico crea abogados temporales con permisos y vigencia. El
    // documento se identifica con el correo del abogado; él puede leer el suyo.
    match /miembros_equipo/{email} {
      allow get: if isSignedIn() &&
          (request.auth.token.email == email ||
           resource.data.masterUid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.masterUid == request.auth.uid;

      function membresiaValida(data) {
        return data.keys().hasOnly([
              'email', 'nombre', 'masterUid', 'masterNombre', 'permisos',
              'vigenteHasta', 'estado', 'creadoEn'
            ]) &&
            data.email == email &&
            data.masterUid == request.auth.uid &&
            isNonEmptyString(data.nombre, 120) &&
            data.permisos is list &&
            data.permisos.hasOnly(['crear_contratos', 'pedir_documentos', 'verificar_documentos']) &&
            data.estado in ['activo', 'suspendido'] &&
            data.vigenteHasta is timestamp &&
            data.vigenteHasta < request.time + duration.value(367, 'd');
      }

      allow create: if isMasterJuridico() &&
          email != request.auth.token.email &&
          membresiaValida(request.resource.data);
      allow update: if isMasterJuridico() &&
          resource.data.masterUid == request.auth.uid &&
          membresiaValida(request.resource.data);
      allow delete: if isMasterJuridico() && resource.data.masterUid == request.auth.uid;
    }

    // =========================================================================
    // 4c. PROCESOS DE CONTRATACIÓN POR MODALIDAD (`procesos_contratacion/{id}`)
    // =========================================================================
    match /procesos_contratacion/{procesoId} {
      allow get, list: if esDelEquipo(resource.data.equipoUid);
      allow create: if isSignedIn() &&
          procesoId.matches('^[a-f0-9]{32}$') &&
          request.resource.data.id == procesoId &&
          request.resource.data.creadoPorUid == request.auth.uid &&
          ((request.resource.data.equipoUid == request.auth.uid && isMasterJuridico()) ||
           permisoEquipo(request.resource.data.equipoUid, 'crear_contratos')) &&
          isNonEmptyString(request.resource.data.numeroProceso, 80) &&
          isNonEmptyString(request.resource.data.objeto, 2000);
      // Nadie cambia el equipo, el creador ni la modalidad de un proceso.
      allow update: if esDelEquipo(resource.data.equipoUid) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.equipoUid == resource.data.equipoUid &&
          request.resource.data.creadoPorUid == resource.data.creadoPorUid &&
          request.resource.data.modalidadId == resource.data.modalidadId;
      // Elimina el proceso quien lo creó, el Master o un abogado con permiso.
      allow delete: if isSignedIn() &&
          ((isMasterJuridico() && (resource.data.creadoPorUid == request.auth.uid ||
                                   resource.data.equipoUid == request.auth.uid)) ||
           permisoEquipo(resource.data.equipoUid, 'crear_contratos'));

      // Documentos de la entidad por etapa (mismo esquema que los expedientes).
      match /archivos/{documentoId} {
        allow get: if esDelEquipo(
            get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid);
        allow create, update: if esDelEquipo(
            get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid) &&
            archivoValido(request.resource.data);
        allow delete: if esDelEquipo(
            get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid);

        match /partes/{parte} {
          allow get: if esDelEquipo(
              get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid);
          allow create, update: if esDelEquipo(
              get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid) &&
              isNonEmptyString(request.resource.data.datos, 950000);
          allow delete: if esDelEquipo(
              get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid);
        }
      }
    }

    // =========================================================================
    // 4d. PLANTILLA DE INFORMES DE LA ENTIDAD (`plantillas_informe/{equipoUid}`)
    // =========================================================================
    match /plantillas_informe/{equipoUid} {
      allow get: if titularSupervision(equipoUid);
      allow create, update: if titularSupervision(equipoUid) &&
          request.resource.data.etapas is list &&
          request.resource.data.etapas.size() > 0 &&
          request.resource.data.etapas.size() <= 5 &&
          request.resource.data.documentos is list &&
          request.resource.data.documentos.size() <= 40;
      allow delete: if false;
    }

    // =========================================================================
    // 5. COLA DE NOTIFICACIONES POR CORREO DE SUBSANACIÓN (`notificaciones_correo/{notifId}`)
    // =========================================================================
    match /notificaciones_correo/{notifId} {
      allow get, list: if isSignedIn() && resource.data.remitenteUid == request.auth.uid;
      allow create: if (isMasterJuridico() ||
           (correoVerificado() &&
            exists(/databases/$(database)/documents/miembros_equipo/$(request.auth.token.email)) &&
            miembroVigente(membresiaPropia().masterUid))) &&
          request.resource.data.remitenteUid == request.auth.uid &&
          isNonEmptyString(request.resource.data.destinatarioEmail, 160) &&
          isNonEmptyString(request.resource.data.asunto, 220);
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. BUZÓN GLOBAL DE RADICADOS PQRS (`pqrs_solicitudes/{radicado}`)
    // =========================================================================
    function nuevaPqrs(radicado) {
      let datos = request.resource.data;
      return isSignedIn() &&
          datos.keys().hasOnly(['radicado', 'tipo_solicitud', 'asunto', 'mensaje',
                                'usuario_nombre', 'correo_contacto', 'usuario_correo_cuenta',
                                'usuario_documento', 'usuario_telefono', 'uid', 'estado',
                                'canal', 'plataforma', 'fecha_creacion', 'fecha_cliente_iso']) &&
          isNonEmptyString(datos.radicado, 48) && datos.radicado == radicado &&
          datos.tipo_solicitud in ['Soporte técnico', 'Petición', 'Queja o reclamo', 'Sugerencia'] &&
          isNonEmptyString(datos.asunto, 160) &&
          isNonEmptyString(datos.mensaje, 3000) &&
          datos.uid == request.auth.uid && datos.estado == 'Radicado' &&
          datos.fecha_creacion == request.time;
    }

    function respuestaAdminPqrs() {
      let despues = request.resource.data;
      return isAdmin() && !('respuesta' in resource.data) &&
          despues.diff(resource.data).affectedKeys().hasOnly(['respuesta', 'estado']) &&
          despues.estado == 'Respondido' && despues.respuesta is map &&
          despues.respuesta.keys().hasOnly(['texto', 'enviada_en', 'autor_uid']) &&
          isNonEmptyString(despues.respuesta.texto, 3000) &&
          despues.respuesta.autor_uid == request.auth.uid &&
          despues.respuesta.enviada_en == request.time;
    }

    function lecturaPqrs(uid) {
      let despues = request.resource.data;
      return isOwner(uid) && resource.data.get('uid', '') == uid &&
          'respuesta' in resource.data &&
          despues.diff(resource.data).affectedKeys().hasOnly(['respuesta_leida_en']) &&
          despues.respuesta_leida_en == resource.data.respuesta.enviada_en;
    }

    // La bandeja administrativa incluye globales y espejos históricos.
    match /{ruta=**}/pqrs_solicitudes/{radicado} {
      allow list: if isAdmin();
    }

    match /pqrs_solicitudes/{radicado} {
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if nuevaPqrs(radicado);
      allow update: if respuestaAdminPqrs() || lecturaPqrs(resource.data.uid);
      allow delete: if false;
    }

    // =========================================================================
    // 7. DENEGACIÓN POR DEFECTO (ZERO-TRUST FALLBACK)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
