rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES AUXILIARES DE SEGURIDAD (OWASP + LEY 1581 DE 2012 COLOMBIA)
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isUnpaidOrBaseRoleOnly(data) {
      return !('rolesActivos' in data) ||
          (data.rolesActivos is list &&
           (data.rolesActivos.size() == 0 ||
            (data.rolesActivos.size() == 1 &&
             data.rolesActivos[0] == 'persona' &&
             (!('pagoWompiPendiente' in data) || data.pagoWompiPendiente == false))));
    }

    // Correos administradores (misma lista que lib/services/admin_access.dart).
    function isAdmin() {
      return isSignedIn() &&
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'danielbg2231@gmail.com',
            'ivanbolano19@gmail.com',
            'ibolano@sena.edu.co'
          ];
    }

    // Titular de la suscripción Equipo Jurídico (o administrador).
    function isMasterJuridico() {
      return isAdmin() ||
          (isSignedIn() &&
           exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rolesActivos', []).hasAny(['equipo_juridico']));
    }

    // Abogado temporal vigente del equipo de `masterUid`: correo verificado,
    // membresía activa y sin vencer (ver lib/services/equipo_juridico_service.dart).
    function membresiaPropia() {
      return get(/databases/$(database)/documents/miembros_equipo/$(request.auth.token.email)).data;
    }

    function miembroVigente(masterUid) {
      return isSignedIn() &&
          request.auth.token.email_verified == true &&
          exists(/databases/$(database)/documents/miembros_equipo/$(request.auth.token.email)) &&
          membresiaPropia().masterUid == masterUid &&
          membresiaPropia().estado == 'activo' &&
          membresiaPropia().vigenteHasta > request.time;
    }

    function permisoEquipo(masterUid, permiso) {
      return miembroVigente(masterUid) && membresiaPropia().permisos.hasAny([permiso]);
    }

    // Master del equipo o abogado vigente de su equipo.
    function esDelEquipo(equipoUid) {
      return isSignedIn() &&
          (equipoUid == request.auth.uid || miembroVigente(equipoUid));
    }

    // Verifica que cualquier activación o acumulación de rol pagado esté
    // respaldada por un recibo aprobado y registrado en el libro mayor `pagos_wompi`.
    function hasVerifiedWompiLedger(data) {
      return ('pagoWompiActivo' in data) &&
          data.pagoWompiActivo == true &&
          ('ultimoPagoWompi' in data) &&
          (data.ultimoPagoWompi is map) &&
          data.ultimoPagoWompi.status == 'APPROVED' &&
          (data.ultimoPagoWompi.transactionId is string) &&
          data.ultimoPagoWompi.transactionId.size() >= 6 &&
          (data.ultimoPagoWompi.integritySignature is string) &&
          data.ultimoPagoWompi.integritySignature.size() == 64 &&
          exists(/databases/$(database)/documents/pagos_wompi/$(data.ultimoPagoWompi.transactionId)) &&
          get(/databases/$(database)/documents/pagos_wompi/$(data.ultimoPagoWompi.transactionId)).data.uid == request.auth.uid;
    }

    // =========================================================================
    // 1. PERFILES DE USUARIO (`usuarios/{uid}`) - PROTECCIÓN ESTRICTA DE PII
    // =========================================================================
    match /usuarios/{uid} {
      // Prohibido listar (`list`) usuarios para impedir raspado masivo de PII
      // (cédulas, teléfonos, correos). Solo el titular autenticado lee su perfil.
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid) &&
          request.resource.data.uid == uid &&
          isUnpaidOrBaseRoleOnly(request.resource.data);

      allow update: if isOwner(uid) &&
          (!('uid' in request.resource.data) || request.resource.data.uid == uid) &&
          // Inmutabilidad de correo, cédula y consentimiento una vez establecidos
          (!('email' in resource.data) ||
           resource.data.email == '' ||
           request.resource.data.email == resource.data.email) &&
          (!('documento' in resource.data) ||
           resource.data.documento == '' ||
           request.resource.data.documento == resource.data.documento) &&
          (!('documentoNormalizado' in resource.data) ||
           resource.data.documentoNormalizado == '' ||
           request.resource.data.documentoNormalizado == resource.data.documentoNormalizado) &&
          (!('aceptacion_datos' in resource.data) ||
           resource.data.aceptacion_datos != true ||
           request.resource.data.aceptacion_datos == true) &&
          // Bloqueo de auto-asignación de roles pagos sin recibo verificado
          (!('rolesActivos' in request.resource.data) ||
           ('rolesActivos' in resource.data &&
            request.resource.data.rolesActivos == resource.data.rolesActivos) ||
           isUnpaidOrBaseRoleOnly(request.resource.data) ||
           hasVerifiedWompiLedger(request.resource.data));

      allow delete: if false;

      // Evidencia probatoria inmutable ante la SIC (Ley 1581/2012 - Art. 8 y 12)
      match /auditoria_consentimiento/{logId} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) &&
            request.resource.data.uid == uid &&
            request.resource.data.aceptacion_datos == true &&
            request.resource.data.aceptacion_politica_privacidad == true;
        allow update, delete: if false;
      }

      // Espejo de radicados PQRS del titular (solo adición, inmutable)
      match /pqrs_solicitudes/{radicado} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) &&
            isNonEmptyString(request.resource.data.asunto, 160) &&
            isNonEmptyString(request.resource.data.mensaje, 3000);
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 2. ÍNDICES OPACOS DE UNICIDAD (`indices_unicidad/{sha256Hash}`)
    // =========================================================================
    match /indices_unicidad/{hash} {
      allow get: if hash.matches('^[a-f0-9]{64}$');
      allow list: if false;
      allow create: if isSignedIn() &&
          hash.matches('^[a-f0-9]{64}$') &&
          !exists(/databases/$(database)/documents/indices_unicidad/$(hash)) &&
          request.resource.data.keys().hasOnly(['tipo', 'uid', 'creado_en']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.tipo in ['email', 'doc'];
      allow update, delete: if false;
    }

    // =========================================================================
    // 3. LIBRO MAYOR INMUTABLE DE PAGOS WOMPI (`pagos_wompi/{transactionId}`)
    // =========================================================================
    match /pagos_wompi/{transactionId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if isSignedIn() &&
          !exists(/databases/$(database)/documents/pagos_wompi/$(transactionId)) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.transactionId == transactionId &&
          request.resource.data.status == 'APPROVED' &&
          (request.resource.data.integritySignature is string) &&
          request.resource.data.integritySignature.size() == 64 &&
          (request.resource.data.amountInCents is int) &&
          request.resource.data.amountInCents > 0;
      allow update, delete: if false;
    }

    // =========================================================================
    // 4. EXPEDIENTES CONTRACTUALES EQUIPO JURÍDICO + PORTAL INVITADO (`expedientes_juridicos/{token}`)
    // =========================================================================
    // El `token` es un identificador criptográfico CSPRNG de 32-64 caracteres hexadecimales:
    // - Prohibido listar globalmente sin ser el propietario creador.
    // - Cualquier actor que posea el enlace con el token criptográfico exacto puede
    //   suscribirse en tiempo real (`get`) y sincronizar cargas, revisiones y trazabilidad.
    match /expedientes_juridicos/{token} {
      allow get: if token.matches('^[a-f0-9]{32,64}$');
      // Listan el creador, el Master del equipo y sus abogados vigentes.
      allow list: if isSignedIn() &&
          (resource.data.creadoPorUid == request.auth.uid ||
           resource.data.equipoUid == request.auth.uid ||
           miembroVigente(resource.data.equipoUid));
      allow create: if token.matches('^[a-f0-9]{32,64}$') &&
          request.resource.data.tokenInvitado == token &&
          isNonEmptyString(request.resource.data.numeroContrato, 80) &&
          isNonEmptyString(request.resource.data.objetoContrato, 2000) &&
          // Un expediente de equipo solo lo crea su Master o un abogado con permiso.
          (request.resource.data.get('equipoUid', '') == '' ||
           (isSignedIn() &&
            (request.resource.data.equipoUid == request.auth.uid ||
             permisoEquipo(request.resource.data.equipoUid, 'crear_contratos'))));
      allow update: if token.matches('^[a-f0-9]{32,64}$') &&
          request.resource.data.tokenInvitado == resource.data.tokenInvitado &&
          request.resource.data.numeroContrato == resource.data.numeroContrato &&
          // El propietario no puede ser reasignado por quien tenga el enlace.
          (!('creadoPorUid' in resource.data) ||
           request.resource.data.creadoPorUid == resource.data.creadoPorUid) &&
          // El equipo tampoco; solo el creador asigna el suyo a expedientes antiguos.
          (resource.data.get('equipoUid', '') == '' ?
              (request.resource.data.get('equipoUid', '') == '' ||
               (isSignedIn() &&
                request.resource.data.equipoUid == request.auth.uid &&
                resource.data.creadoPorUid == request.auth.uid)) :
              request.resource.data.get('equipoUid', '') == resource.data.equipoUid);
      allow delete: if isSignedIn() && resource.data.creadoPorUid == request.auth.uid;

      // Subcolección de binarios individuales para sincronización entre dispositivos
      match /archivos/{apartadoId} {
        allow get, list: if token.matches('^[a-f0-9]{32,64}$');
        allow create, update: if token.matches('^[a-f0-9]{32,64}$') &&
            isNonEmptyString(request.resource.data.archivoBase64, 950000);
        allow delete: if false;
      }
    }

    // =========================================================================
    // 4b. EQUIPO JURÍDICO "MASTER CHIEF" (`miembros_equipo/{correo}`)
    // =========================================================================
    // El Master Jurídico crea abogados temporales con permisos y vigencia. El
    // documento se identifica con el correo del abogado; él puede leer el suyo.
    match /miembros_equipo/{email} {
      allow get: if isSignedIn() &&
          (request.auth.token.email == email ||
           resource.data.masterUid == request.auth.uid);
      allow list: if isSignedIn() && resource.data.masterUid == request.auth.uid;

      function membresiaValida(data) {
        return data.keys().hasOnly([
              'email', 'nombre', 'masterUid', 'masterNombre', 'permisos',
              'vigenteHasta', 'estado', 'creadoEn'
            ]) &&
            data.email == email &&
            data.masterUid == request.auth.uid &&
            isNonEmptyString(data.nombre, 120) &&
            data.permisos is list &&
            data.permisos.hasOnly(['crear_contratos', 'pedir_documentos', 'verificar_documentos']) &&
            data.estado in ['activo', 'suspendido'] &&
            data.vigenteHasta is timestamp &&
            data.vigenteHasta < request.time + duration.value(367, 'd');
      }

      allow create: if isMasterJuridico() &&
          email != request.auth.token.email &&
          membresiaValida(request.resource.data);
      allow update: if isSignedIn() &&
          resource.data.masterUid == request.auth.uid &&
          membresiaValida(request.resource.data);
      allow delete: if isSignedIn() && resource.data.masterUid == request.auth.uid;
    }

    // =========================================================================
    // 4c. PROCESOS DE CONTRATACIÓN POR MODALIDAD (`procesos_contratacion/{id}`)
    // =========================================================================
    match /procesos_contratacion/{procesoId} {
      allow get, list: if esDelEquipo(resource.data.equipoUid);
      allow create: if isSignedIn() &&
          procesoId.matches('^[a-f0-9]{32}$') &&
          request.resource.data.id == procesoId &&
          request.resource.data.creadoPorUid == request.auth.uid &&
          ((request.resource.data.equipoUid == request.auth.uid && isMasterJuridico()) ||
           permisoEquipo(request.resource.data.equipoUid, 'crear_contratos')) &&
          isNonEmptyString(request.resource.data.numeroProceso, 80) &&
          isNonEmptyString(request.resource.data.objeto, 2000);
      // Nadie cambia el equipo, el creador ni la modalidad de un proceso.
      allow update: if esDelEquipo(resource.data.equipoUid) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.equipoUid == resource.data.equipoUid &&
          request.resource.data.creadoPorUid == resource.data.creadoPorUid &&
          request.resource.data.modalidadId == resource.data.modalidadId;
      allow delete: if false;

      // Documentos de la entidad por etapa (mismo esquema que los expedientes).
      match /archivos/{documentoId} {
        allow get: if esDelEquipo(
            get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid);
        allow create, update: if esDelEquipo(
            get(/databases/$(database)/documents/procesos_contratacion/$(procesoId)).data.equipoUid) &&
            isNonEmptyString(request.resource.data.archivoBase64, 950000);
        allow delete: if false;
      }
    }

    // =========================================================================
    // 5. COLA DE NOTIFICACIONES POR CORREO DE SUBSANACIÓN (`notificaciones_correo/{notifId}`)
    // =========================================================================
    match /notificaciones_correo/{notifId} {
      allow get, list: if isSignedIn() && resource.data.remitenteUid == request.auth.uid;
      allow create: if isSignedIn() &&
          request.resource.data.remitenteUid == request.auth.uid &&
          isNonEmptyString(request.resource.data.destinatarioEmail, 160) &&
          isNonEmptyString(request.resource.data.asunto, 220);
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. BUZÓN GLOBAL DE RADICADOS PQRS (`pqrs_solicitudes/{radicado}`)
    // =========================================================================
    match /pqrs_solicitudes/{radicado} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if isNonEmptyString(request.resource.data.radicado, 48) &&
          request.resource.data.radicado == radicado &&
          request.resource.data.tipo_solicitud in [
            'Soporte técnico',
            'Petición',
            'Queja o reclamo',
            'Sugerencia'
          ] &&
          isNonEmptyString(request.resource.data.asunto, 160) &&
          isNonEmptyString(request.resource.data.mensaje, 3000) &&
          (isSignedIn()
              ? request.resource.data.uid == request.auth.uid
              : request.resource.data.uid == '');
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. DENEGACIÓN POR DEFECTO (ZERO-TRUST FALLBACK)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
